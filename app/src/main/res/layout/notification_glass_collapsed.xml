<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical">

    <!-- Left Status Section: Icon + Title & Subtitle Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/notification_status_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_widget_ring"
            android:contentDescription="Status Icon" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ring Mode"
                android:textColor="#DEFFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notification_subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Screen Locked"
                android:textColor="#99FFFFFF"
                android:textSize="10.5sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Controls Section: 3 Direct Compact Widget Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Widget 1: Force Silent / Force Ring Toggle -->
        <LinearLayout
            android:id="@+id/widget_btn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_glass_widget_button"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginEnd="4dp">

            <ImageView
                android:id="@+id/widget_toggle_icon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_widget_silent"
                android:contentDescription="Toggle" />

            <TextView
                android:id="@+id/widget_toggle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:text="Silent"
                android:textColor="#DEFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Widget 2: Pause 1h -->
        <LinearLayout
            android:id="@+id/widget_btn_pause"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_glass_widget_button"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_widget_pause"
                android:contentDescription="Pause" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="3dp"
                android:text="1h"
                android:textColor="#DEFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Widget 3: Auto / Resume -->
        <LinearLayout
            android:id="@+id/widget_btn_auto"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_glass_widget_button"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_widget_auto"
                android:contentDescription="Auto" />

            <TextView
                android:id="@+id/widget_auto_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="3dp"
                android:text="Auto"
                android:textColor="#DEFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
