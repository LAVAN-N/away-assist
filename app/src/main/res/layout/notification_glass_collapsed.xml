<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:background="@drawable/bg_glass_notification"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical">

    <!-- Left Status Section: Icon + Mode Title + State Badge -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/notification_status_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_widget_ring"
            android:contentDescription="Status Icon" />

        <TextView
            android:id="@+id/notification_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:text="Ring"
            android:textColor="#FFFFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notification_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_glass_status_pill"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1.5dp"
            android:paddingBottom="1.5dp"
            android:text="LOCKED"
            android:textColor="#E6FFFFFF"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Right Controls Section: 3 Direct Compact Widget Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Widget 1: Force Silent / Force Ring Toggle -->
        <LinearLayout
            android:id="@+id/widget_btn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_glass_widget_button"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginEnd="4dp">

            <ImageView
                android:id="@+id/widget_toggle_icon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_widget_silent"
                android:contentDescription="Toggle" />

            <TextView
                android:id="@+id/widget_toggle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="3.5dp"
                android:text="Silent"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Widget 2: Pause 1h -->
        <LinearLayout
            android:id="@+id/widget_btn_pause"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_glass_widget_button"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_widget_pause"
                android:contentDescription="Pause" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="3dp"
                android:text="1h"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Widget 3: Auto / Resume -->
        <LinearLayout
            android:id="@+id/widget_btn_auto"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_glass_widget_button"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_auto_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_widget_auto"
                android:contentDescription="Auto" />

            <TextView
                android:id="@+id/widget_auto_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="3dp"
                android:text="Auto"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
