<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical">

    <!-- Left Status Section: Icon + Title & Pill Cell Badge + Subtitle Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="6dp">

        <ImageView
            android:id="@+id/notification_status_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_widget_ring"
            android:contentDescription="Status Icon" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- Title & Distinct Cell Badge (No [] brackets) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/notification_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ring Mode"
                    android:textColor="#DEFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_glass_status_pill"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1.5dp"
                    android:paddingBottom="1.5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/notification_mode_dot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:src="@drawable/anim_dot_green"
                        android:contentDescription="Status Dot" />

                    <TextView
                        android:id="@+id/notification_mode_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3.5dp"
                        android:text="AUTO"
                        android:textColor="#E6FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/notification_subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:text="Screen Locked"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Controls Section: 3 Direct Compact Widget Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Widget 1: Force Silent / Force Ring Toggle -->
        <LinearLayout
            android:id="@+id/widget_btn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_glass_widget_button"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginEnd="4dp">

            <ImageView
                android:id="@+id/widget_toggle_icon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_widget_silent"
                android:contentDescription="Toggle" />

            <TextView
                android:id="@+id/widget_toggle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:text="Silent"
                android:textColor="#DEFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Widget 2: Pause 10m -->
        <LinearLayout
            android:id="@+id/widget_btn_pause"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_glass_widget_button"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_widget_pause"
                android:contentDescription="Pause" />

            <TextView
                android:id="@+id/widget_pause_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="3dp"
                android:text="10m"
                android:textColor="#DEFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Widget 3: Auto / Resume -->
        <LinearLayout
            android:id="@+id/widget_btn_auto"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_glass_widget_button"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_widget_auto"
                android:contentDescription="Auto" />

            <TextView
                android:id="@+id/widget_auto_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="3dp"
                android:text="Auto"
                android:textColor="#DEFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
